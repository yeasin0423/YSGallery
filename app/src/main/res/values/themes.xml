<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch window and the Android 12 splash follow the phone's light/dark mode, so the
         first frame is not a black screen in light mode. The app theme itself is drawn by Compose
         and can still be pinned independently from Appearance. -->
    <style name="Theme.Gallery" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">@bool/splash_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/splash_light_bars</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    </style>
</resources>
